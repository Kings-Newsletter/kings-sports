# URL pública do portal (usada em canonical, Open Graph, sitemap e robots)
NEXT_PUBLIC_SITE_URL=https://kingsnewsletter.com/sports

# Subcaminho onde o portal é servido.
# Use NEXT_PUBLIC_BASE_PATH="" para servir na raiz do domínio.
NEXT_PUBLIC_BASE_PATH=/sports

# Nome e contato exibidos em rodapé/política editorial
NEXT_PUBLIC_EDITORIAL_EMAIL=editorial@kingsnewsletter.com
NEXT_PUBLIC_NEWSLETTER_URL=https://kingsnewsletter.com

# ------------------------------------------------------------------ Banco
# Mesmo cluster e banco da King's Newsletter. O King's Sports só usa a coleção
# MONGODB_COLLECTION; nunca lê nem escreve nas coleções da Newsletter.
# Sem MONGODB_URI o portal roda em modo arquivo (lê /content).
MONGODB_URI=
# Mesmo banco da Newsletter: kings_newsletter (produção) ou kings_newsletter_preview
MONGODB_DB=kings_newsletter
MONGODB_COLLECTION=sports

# ----------------------------------------------------------------- Coleta
# A coleta de dados (placar ao vivo, jogos, tabelas, escudos e temporada) roda
# no King's Worker (kings-worker), não no portal. As
# chaves e os limites dos provedores ficam configurados lá.
