# URL pública do portal (usada em canonical, Open Graph, sitemap e robots)
NEXT_PUBLIC_SITE_URL=https://kingsnewsletter.com/sports

# Subcaminho onde o portal é servido.
# Use NEXT_PUBLIC_BASE_PATH="" para servir na raiz do domínio.
# Se mudar, ajuste também o "path" do cron em vercel.json.
NEXT_PUBLIC_BASE_PATH=/sports

# Nome e contato exibidos em rodapé/política editorial
NEXT_PUBLIC_EDITORIAL_EMAIL=editorial@kingsnewsletter.com
NEXT_PUBLIC_NEWSLETTER_URL=https://kingsnewsletter.com

# ------------------------------------------------------------------ Banco
# Mesmo cluster e banco da King's Newsletter. O King's Sports só usa a coleção
# MONGODB_COLLECTION; nunca lê nem escreve nas coleções da Newsletter.
# Sem MONGODB_URI o portal roda em modo arquivo (lê /content).
MONGODB_URI=
# Mesmo banco da Newsletter: kings_newsletter (produção) ou kings_newsletter_preview
MONGODB_DB=kings_newsletter
MONGODB_COLLECTION=sports

# ----------------------------------------------------------------- Coleta
# Segredo exigido por /api/cron/* (Authorization: Bearer <CRON_SECRET>).
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# SportAPI (reserva de futebol e NBA) — chave grátis em https://sportapi.ai
SPORTAPI_KEY=
# Limites de segurança (plano grátis: 1.000/dia e 7.000/mês)
SPORTAPI_DAILY_BUDGET=220
SPORTAPI_MONTHLY_BUDGET=6800

# ESPN (fonte principal, sem chave): teto de segurança e intervalo do ao vivo
ESPN_DAILY_BUDGET=3000
ESPN_LIVE_MIN_INTERVAL_SEC=15

# Agendador local (instrumentation.ts): ligado por padrão em `npm run dev`.
# Em `next start`, ligue com LOCAL_SCHEDULER=true; desligue com false.
LOCAL_SCHEDULER=
LOCAL_LIVE_EVERY_SEC=15

# Intervalo mínimo, em minutos, entre coletas ao vivo da SportAPI (reserva)
LIVE_MIN_INTERVAL_MIN=10
